# Copy to .env. Docker Compose reads it for variable substitution.
# .env is git-ignored; never commit real values.

# Required in production (docker-compose.prod.yml refuses to start without it).
# Generate one with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# production | development. In development the API returns the sign-in access
# code in the response so no mailbox is needed. Never do that on a public host.
PLAYUP_ENVIRONMENT=production

# Host port nginx listens on.
WEB_PORT=80

# JSON list of extra origins allowed to call the API directly. Not needed
# when the frontend is served by this stack (nginx proxies /api same-origin).
# PLAYUP_CORS_ORIGINS=["https://playup.example.com"]
